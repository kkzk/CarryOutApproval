        {
            "label": "Django: ASGI Dev (uvicorn --reload)",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "uvicorn",
                "carry_out_approval.asgi:application",
                "--host","127.0.0.1",
                "--port","8000",
                "--reload",
                "--reload-dir",".",
                "--reload-dir","applications/templates",
                "--reload-dir","notifications",
                "--reload-dir","templates",
                "--reload-include","*.html"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
