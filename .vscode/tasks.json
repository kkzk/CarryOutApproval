{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Django: runserver (uv)",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "manage.py",
                "runserver",
                "8000"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": [],
            "isBackground": true,
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "Django: Collect Static Files",
            "type": "shell",
            "command": "uv",
